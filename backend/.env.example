# إعدادات الواجهة الخلفية
ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=5002
BACKEND_CORS_ORIGINS=http://localhost:3005,http://127.0.0.1:3005

# اتصال PostgreSQL المحلي
DATABASE_URL=postgresql://eduassist:eduassist@127.0.0.1:5432/eduassist

# تشديد فك تسلسل نقاط التفتيش
LANGGRAPH_STRICT_MSGPACK=true

# نموذج اللغة الكبير
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
